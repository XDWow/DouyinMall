# 复制为 .env.middleware 后填写，不要提交真实文件。
# 启动：docker compose --env-file .env.middleware -f docker-compose.middleware.yml up -d
#
# ---------- 两机走公网直连（你当前：不同 VPC，直接外网连）----------
# 1) 中间件 CVM 绑定「弹性公网 IP」，安全组入站放行：13306 / 16379 / 12379 / 29092（或你改的端口）。
# 2) 入站「来源」尽量只填应用机访问公网时露出的出口 IP（固定出口可用 NAT 网关 EIP）；勿对 0.0.0.0/0 开放数据库端口。
# 3) 下面 KAFKA_HOST_ADVERTISE 填与业务配置相同的「中间件公网 IP 或已解析的域名」；Kafka 客户端与 broker 二次握手都依赖这个地址。
# 4) 应用机各服务配置：MySQL/Redis/Etcd/Kafka 一律写 公网IP:端口（或域名:端口）。密码见 MYSQL_ROOT_PASSWORD / REDIS_PASSWORD。
# 5) 明文走公网易被窃听；能上加 TLS / SSH 隧道更好。至少强密码 + 安全组限源。
#
# ---------- 两机同 VPC（可选，更省事）----------
# 应用机写中间件「内网 IP」+ 端口；安全组放行应用机内网 IP；KAFKA_HOST_ADVERTISE 用同一内网 IP。
#
# 与各 Go 服务配置对齐（公网时把「中间件IP」换成弹性公网 IP 或域名）：
# - MySQL DSN：tcp(中间件IP:MYSQL_PUBLISH_PORT)/... 密码=MYSQL_ROOT_PASSWORD；库名默认 douyinmall。
# - Redis：addr=中间件IP:REDIS_PUBLISH_PORT，password=REDIS_PASSWORD。
# - Etcd：endpoints 含 http://中间件IP:ETCD_PUBLISH_PORT
# - Kafka brokers：中间件IP:KAFKA_PUBLISH_PORT_EXTERNAL（应用机走 HOST 监听器）。
#
# ---------- 单机（中间件 + 微服务全在本机）----------
# MYSQL/REDIS/ETCD 的 *_BIND_ADDRESS 可改为 127.0.0.1；本机二进制用 127.0.0.1:端口；同 compose 内容器仍用 douyinmall-* 主机名。

MYSQL_ROOT_PASSWORD=REPLACE_WITH_LONG_RANDOM_SECRET
MYSQL_PUBLISH_PORT=13306
MYSQL_BIND_ADDRESS=0.0.0.0

REDIS_PASSWORD=REPLACE_WITH_LONG_RANDOM_SECRET
REDIS_PUBLISH_PORT=16379
REDIS_BIND_ADDRESS=0.0.0.0

ETCD_PUBLISH_PORT=12379
ETCD_BIND_ADDRESS=0.0.0.0

KAFKA_HOST_ADVERTISE=REPLACE_WITH_MIDDLEWARE_PUBLIC_EIP_OR_DNS
KAFKA_PUBLISH_PORT_PLAIN=9092
KAFKA_PUBLISH_PORT_EXTERNAL=29092
KAFKA_BIND_ADDRESS=0.0.0.0
