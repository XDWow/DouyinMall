//go:build legacy_agent

package usecase

import (
	"context"
	"fmt"
	"strings"
	"time"

	"github.com/XDWow/DouyinMall/backend/internal/agent/domain"
	"github.com/XDWow/DouyinMall/backend/internal/search/infra/ai"
	"github.com/XDWow/DouyinMall/backend/pkg/logger"
)

const (
	maxWindowSize  = 10   // 滑动窗口大小
	maxSummaryLen  = 200  // 摘要最大字符数
	cacheThreshold = 0.95 // 语义缓存命中阈值
)

// ChatUseCase 四阶段对话 Pipeline
// Stage 1: 会话加载 + 语义缓存
// Stage 2: 意图识别 + Query 改写
// Stage 3: RAG 检索（两阶段）
// Stage 4: 回复生成
type ChatUseCase struct {
	sessionRepo   domain.SessionRepo
	knowledgeRepo domain.KnowledgeRepo
	cache         domain.SemanticCache
	llm           ai.LLMClient
	embedder      ai.Embedder
	logger        logger.LoggerV1
}

func NewChatUseCase(
	sessionRepo domain.SessionRepo,
	knowledgeRepo domain.KnowledgeRepo,
	cache domain.SemanticCache,
	llm ai.LLMClient,
	embedder ai.Embedder,
	logger logger.LoggerV1,
) *ChatUseCase {
	return &ChatUseCase{
		sessionRepo:   sessionRepo,
		knowledgeRepo: knowledgeRepo,
		cache:         cache,
		llm:           llm,
		embedder:      embedder,
		logger:        logger,
	}
}

func (uc *ChatUseCase) Execute(ctx context.Context, req *domain.ChatReq) (*domain.ChatResp, error) {
	start := time.Now()
	debug := &domain.PipelineDebug{}

	// ---- Stage 1: 会话加载 ----
	session, err := uc.sessionRepo.Load(ctx, req.SessionID)
	if err != nil {
		return nil, fmt.Errorf("load session: %w", err)
	}

	// 语义缓存检查
	vectors, embErr := uc.embedder.Embed(ctx, []string{req.Message})
	if embErr == nil && len(vectors) > 0 {
		if reply, hit, _ := uc.cache.Lookup(ctx, vectors[0]); hit {
			debug.CacheHit = true
			debug.TotalMs = time.Since(start).Milliseconds()
			return &domain.ChatResp{
				Reply:      reply,
				Intent:     domain.IntentFAQ,
				Confidence: 1.0,
				Debug:      debug,
			}, nil
		}
	}

	// ---- Stage 2: 意图识别 + Query 改写 ----
	t := time.Now()
	intentResult, intentErr := uc.recognizeIntent(ctx, req.Message, session.RecentMessages(3))
	debug.IntentMs = time.Since(t).Milliseconds()
	if intentErr != nil {
		uc.logger.Warn("意图识别失败，降级为 UNKNOWN", logger.Error(intentErr))
		intentResult = &domain.IntentResult{
			Type:           domain.IntentUnknown,
			Confidence:     0,
			RewrittenQuery: req.Message, // 降级：用原始消息
		}
	}
	debug.RewrittenQuery = intentResult.RewrittenQuery

	// 快速路径：转人工
	if intentResult.Type == domain.IntentTransferToHuman {
		debug.TotalMs = time.Since(start).Milliseconds()
		return &domain.ChatResp{
			Reply:      "正在为您转接人工客服，请稍候...",
			Intent:     domain.IntentTransferToHuman,
			Confidence: intentResult.Confidence,
			Debug:      debug,
		}, nil
	}

	// ---- Stage 3: RAG 检索（两阶段） ----
	// 3a. Embedding（用改写后的 query）
	t = time.Now()
	queryVec, embedErr := uc.embedder.Embed(ctx, []string{intentResult.RewrittenQuery})
	debug.EmbedMs = time.Since(t).Milliseconds()

	var knowledge []domain.KnowledgeRef
	if embedErr == nil && len(queryVec) > 0 {
		// 3b. Milvus 向量召回 Top-20
		t = time.Now()
		candidates, vecErr := uc.knowledgeRepo.VectorSearch(ctx, queryVec[0], 20)
		debug.VectorMs = time.Since(t).Milliseconds()

		if vecErr == nil && len(candidates) > 0 {
			// 3c. LLM 重排 Top-3
			t = time.Now()
			knowledge = uc.rerankByLLM(ctx, req.Message, candidates, 3)
			debug.RerankMs = time.Since(t).Milliseconds()
		}
	}
	debug.KnowledgeHits = int32(len(knowledge))

	// ---- Stage 4: 回复生成 ----
	t = time.Now()
	messages := uc.buildMessages(session, req.Message, knowledge)
	llmResp, llmErr := uc.llm.ChatCompletion(ctx, ai.ChatRequest{
		Messages:    messages,
		Temperature: 0.3, // 客服场景低温度
		MaxTokens:   512,
	})
	debug.GenerateMs = time.Since(t).Milliseconds()

	if llmErr != nil {
		uc.logger.Warn("LLM 生成失败，走兜底", logger.Error(llmErr))
		debug.TotalMs = time.Since(start).Milliseconds()
		return &domain.ChatResp{
			Reply:      "抱歉，系统繁忙，请稍后重试或联系人工客服。",
			Intent:     intentResult.Type,
			Confidence: 0,
			Debug:      debug,
		}, nil
	}

	reply, confidence := uc.parseReply(llmResp.Content)
	reply = uc.applyConfidenceFallback(reply, confidence)

	// 写入语义缓存（高置信度回复才缓存）
	if confidence >= 0.8 && embErr == nil && len(vectors) > 0 {
		go uc.cache.Store(context.Background(), vectors[0], reply)
	}

	// 异步持久化
	go uc.persistAsync(context.Background(), session, req, reply, intentResult, confidence, debug)

	debug.TotalMs = time.Since(start).Milliseconds()
	return &domain.ChatResp{
		Reply:      reply,
		Intent:     intentResult.Type,
		Confidence: confidence,
		Knowledge:  knowledge,
		Debug:      debug,
	}, nil
}

// applyConfidenceFallback 置信度降级
func (uc *ChatUseCase) applyConfidenceFallback(reply string, confidence float32) string {
	switch {
	case confidence >= 0.8:
		return reply
	case confidence >= 0.5:
		return reply + "\n\n（以上信息仅供参考，如需进一步帮助请联系人工客服）"
	default:
		return "抱歉，我暂时无法准确回答您的问题。建议您联系人工客服获取帮助。"
	}
}

// buildMessages 拼装 LLM 输入（系统提示 + 摘要 + 知识 + 滑动窗口 + 当前输入）
func (uc *ChatUseCase) buildMessages(session *domain.Session, userMsg string, knowledge []domain.KnowledgeRef) []ai.Message {
	msgs := []ai.Message{{Role: "system", Content: systemPrompt}}

	if session.Summary != "" {
		msgs = append(msgs, ai.Message{Role: "system", Content: "【历史摘要】" + session.Summary})
	}

	if len(knowledge) > 0 {
		var sb strings.Builder
		for i, k := range knowledge {
			fmt.Fprintf(&sb, "%d. [%s] %s\n%s\n\n", i+1, k.Category, k.Title, k.Snippet)
		}
		msgs = append(msgs, ai.Message{Role: "system", Content: "【知识库上下文】\n" + sb.String()})
	}

	for _, m := range session.RecentMessages(maxWindowSize) {
		msgs = append(msgs, ai.Message{Role: string(m.Role), Content: m.Content})
	}

	msgs = append(msgs, ai.Message{Role: "user", Content: userMsg})
	return msgs
}

// persistAsync 异步保存消息到会话（不阻塞响应）
func (uc *ChatUseCase) persistAsync(
	ctx context.Context,
	session *domain.Session,
	req *domain.ChatReq,
	reply string,
	intent *domain.IntentResult,
	confidence float32,
	debug *domain.PipelineDebug,
) {
	now := time.Now()
	// 追加用户消息
	session.Messages = append(session.Messages, domain.Message{
		SessionID: session.ID,
		Role:      domain.RoleUser,
		Content:   req.Message,
		CreatedAt: now,
	})
	// 追加 AI 回复
	session.Messages = append(session.Messages, domain.Message{
		SessionID:  session.ID,
		Role:       domain.RoleAssistant,
		Content:    reply,
		Intent:     intent.Type,
		Confidence: confidence,
		TokensUsed: 0,
		LatencyMs:  debug.TotalMs,
		CreatedAt:  now,
	})
	session.TotalTurns++
	session.UpdatedAt = now

	if err := uc.sessionRepo.Save(ctx, session); err != nil {
		uc.logger.Error("持久化会话失败", logger.Error(err))
	}
}
