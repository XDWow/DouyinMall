	"github.com/cloudwego/eino/compose"
	"github.com/cloudwego/eino/components/embedding"
	"github.com/cloudwego/eino/components/model"
	einoprompt "github.com/cloudwego/eino/components/prompt"
	einoretriever "github.com/cloudwego/eino/components/retriever"
	"github.com/cloudwego/eino/schema"
	"go.opentelemetry.io/otel/trace"

	"github.com/XDWow/DouyinMall/backend/internal/agent/cache"
	"github.com/XDWow/DouyinMall/backend/internal/agent/dto"
	"github.com/XDWow/DouyinMall/backend/internal/agent/memory"
	agenttool "github.com/XDWow/DouyinMall/backend/internal/agent/tool"
	"github.com/XDWow/DouyinMall/backend/pkg/logger"
)

type Config struct {
	RateLimitPerMinute       int64
	ConversationWindow       int
	CacheTTL                 time.Duration
	CacheSimilarityThreshold float64
	CacheCandidateLimit      int
	RetrieveTopK             int
	RetrieveMinScore         float64
	RerankTopK               int
	ConfidenceThreshold      float64
	StrongAnswerThreshold    float64
	SummaryTriggerTurns      int
	MaxAnswerTokens          int
	StreamBuffer             int
	InterruptBeforeNodes     []string
	InterruptAfterNodes      []string
}

func DefaultConfig() Config {
	return Config{
		RateLimitPerMinute:       30,
		ConversationWindow:       8,
		CacheTTL:                 12 * time.Hour,
		CacheSimilarityThreshold: 0.96,
		CacheCandidateLimit:      12,
		RetrieveTopK:             8,
		RetrieveMinScore:         0.35,
		RerankTopK:               4,
		ConfidenceThreshold:      0.62,
		StrongAnswerThreshold:    0.84,
		SummaryTriggerTurns:      12,
		MaxAnswerTokens:          512,
		StreamBuffer:             16,
	}
}

type Dependencies struct {
	Model           model.ToolCallingChatModel
	Embedder        embedding.Embedder
	Retriever       einoretriever.Retriever
	Registry        *agenttool.Registry
	SessionStore    memory.Store
	Summarizer      memory.Summarizer
	SemanticCache   cache.SemanticCache
	RateLimiter     cache.RateLimiter
	CheckpointStore cache.CheckpointStore
	Prompts         *PromptSet
	Logger          logger.LoggerV1
	Metrics         *Metrics
	Tracer          trace.Tracer
}

type StreamWriter interface {
	Send(ctx context.Context, event dto.StreamEvent) error
}

type ChatService interface {
	Chat(ctx context.Context, req dto.ChatRequest) (*dto.ChatResponse, error)
	ChatStream(ctx context.Context, req dto.ChatRequest, writer StreamWriter) (*dto.ChatResponse, error)
	CreateSession(ctx context.Context, userID int64, channel string) (*dto.Session, error)
	GetHistory(ctx context.Context, sessionID string, limit, offset int) ([]dto.Message, int, error)
	ListSessions(ctx context.Context, userID int64, limit, offset int) ([]dto.Session, int, error)
	ClearSession(ctx context.Context, sessionID string) error
}

type PromptSet struct {
	SystemText string
	Intent     einoprompt.ChatTemplate
	Rewrite    einoprompt.ChatTemplate
	Answer     einoprompt.ChatTemplate
}

type Service struct {
	cfg             Config
	model           model.ToolCallingChatModel
	embedder        embedding.Embedder
	retriever       einoretriever.Retriever
	registry        *agenttool.Registry
	sessionStore    memory.Store
	summarizer      memory.Summarizer
	semanticCache   cache.SemanticCache
	rateLimiter     cache.RateLimiter
	checkpointStore cache.CheckpointStore
	prompts         *PromptSet
	logger          logger.LoggerV1
	metrics         *Metrics
	tracer          trace.Tracer
	runnable        compose.Runnable[*FlowContext, *FlowContext]
}

type FlowContext struct {
	StartedAt  time.Time
	TraceID    string
	Request    dto.ChatRequest
	Session    *memory.Session
	Response   *dto.ChatResponse
	Checkpoint string

	StreamWriter StreamWriter
	Recorder     *agenttool.SafeExecutionRecorder

	QueryVector []float64
	CacheItem   *cache.SemanticCacheItem
	Intent      IntentDecision
	Risk        RiskDecision
	Rewrite     RewriteDecision
	Retrieval   RetrievalResult
	Tool        ToolDecision
	Answer      AnswerResult
}

type IntentDecision struct {
	Intent      dto.Intent
	Confidence  float64
	Entities    map[string]string
	NeedRewrite bool
	Reason      string
}

type RiskDecision struct {
	ForceHandoff bool
	Reason       string
	RiskLevel    string
}

type RewriteDecision struct {
	Query  string
	Reason string
}

type RetrievalResult struct {
	Query      string
	Documents  []*schema.Document
	References []dto.KnowledgeRef
}

type ToolDecision struct {
	NeedTool        bool
	AllowedToolList []string
	DecisionMessage *schema.Message
	Plans           []dto.ToolCallPlan
	ToolMessages    []*schema.Message
}

type AnswerResult struct {
	Reply      string
	Confidence float64
	Source     string
}

type SessionGuardInput struct {
	Request dto.ChatRequest `json:"request"`
}

type SessionGuardOutput struct {
	Session *memory.Session `json:"session"`
	TraceID string          `json:"trace_id"`
}

type CacheLookupInput struct {
