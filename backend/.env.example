# Loaded by cmd/agent when you run from the backend directory:
#   go run ./cmd/agent --config internal/agent/config/prod.yaml
#
# Copy this file to backend/.env and fill real values there.
# Addresses, ports, usernames, databases, and Qdrant collection live in dev.yaml/prod.yaml.

# Required: MySQL password for the db.* location configured in YAML.
DB_PASSWORD=CHANGE_ME_DB_PASSWORD

# Optional: product Canal MySQL replication password, only needed when canal.enabled=true.
CANAL_MYSQL_PASSWORD=

# Required: LLM key. LLM_API_KEY is used by both weak and strong models unless split keys are set.
LLM_API_KEY=CHANGE_ME_LLM_API_KEY
# Optional split keys:
# LLM_WEAK_API_KEY=CHANGE_ME_WEAK_LLM_API_KEY
# LLM_STRONG_API_KEY=CHANGE_ME_STRONG_LLM_API_KEY

# Optional: Redis password. Redis address/db are configured in internal/agent/config/*.yaml.
REDIS_PASSWORD=

# Optional: Qdrant API key. Qdrant address/port/collection are configured in YAML.
QDRANT_API_KEY=

# Optional: only needed if the configured embedding provider requires an API key.
# If omitted, LLM_API_KEY is reused for embedding.api_key.
EMBEDDING_API_KEY=
