# 复制为 .env 后在服务器上填写（不要提交 .env）
# cp .env.example .env

# MySQL root 密码（生产务必改强密码）
MYSQL_ROOT_PASSWORD=your_strong_password

# Backend services use this password with db.* YAML locations.
DB_PASSWORD=your_strong_password

# Optional: only needed when product canal.enabled=true.
CANAL_MYSQL_PASSWORD=your_strong_password

# 可选，默认 douyinmall
# MYSQL_DATABASE=douyinmall

# Kafka：给「宿主机/外网客户端」用的广播地址。
# - 只在服务器本机连 Kafka：127.0.0.1
# - 其它机器连该服务器：填服务器 IP 或 DNS（与 bootstrap.servers 一致）
KAFKA_HOST=127.0.0.1
